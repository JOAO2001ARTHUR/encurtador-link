# ===================================================
# Configurações do ÁgilLink - Encurtador & Redirecionador
# ===================================================

# Para desenvolvimento local, nenhuma variável é obrigatória!
# O sistema salva automaticamente em data/links.json

# Para produção na Vercel com máxima velocidade e redundância:
# Adicione a integração Upstash Redis em 1-clique na dashboard da Vercel
# (Vercel Project -> Storage -> Create Database -> Upstash Redis)
# A Vercel injetará automaticamente as variáveis abaixo:

KV_REST_API_URL=https://sua-instancia.upstash.io
KV_REST_API_TOKEN=seu_token_aqui

# Ou alternativamente:
# UPSTASH_REDIS_REST_URL=https://sua-instancia.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu_token_aqui
